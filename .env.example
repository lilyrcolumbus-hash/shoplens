# Copy to .env.local for local development, or set these as build variables in Cloudflare Pages.
# URL of your deployed worker (see README, "Verify it yourself").
VITE_WORKER_URL=https://shoplens-push.<your-subdomain>.workers.dev
# Public half of your VAPID key pair (the private half is a worker secret).
VITE_VAPID_PUBLIC=
